# relays — CYD ESP32-2432S028R (ESP32 classico) com NimBLE + WiFi/ESP-NOW + LVGL.
# Os dois papeis (A central, B peripheral) rodam no mesmo chip CYD; o papel vai por
# -DRELAY_ROLE. Antes A era ESP32-S3 e B era ESP32-C3; agora ambos sao ESP32 classico.
CONFIG_IDF_TARGET="esp32"

# CYD: flash de 4 MB, CPU a 240 MHz, tick de 1 kHz (LVGL/animacao suaves).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# BT + host NimBLE (Relay A = central, Relay B = peripheral; um binario por papel).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# In BLE mode (RELAY_LINK_SELFTEST 0) the binary (BT+WiFi+NimBLE+LVGL) grows past 1 MB and
# overflows the default app partition. The "single app large" table gives about 1.5 MB of app.
# Serial OTA needs two app slots (see components/serial_ota)
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# WiFi/ESP-NOW share the 2.4 GHz radio with BLE (software coexistence).
# That coexistence cost is intentional: it is measured data (the link overhead).
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# BT + WiFi + LVGL + the UART driver (serial_ota) together overflow the classic ESP32 IRAM
# (.iram0.text does not fit). The optimised WiFi functions move from IRAM to flash, which frees
# spare IRAM (it costs a little WiFi throughput, irrelevant for ESP-NOW frames).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# LVGL 8.3 (igual a bancada deskrab): cor 16 bits com swap (ST7789 por SPI).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
